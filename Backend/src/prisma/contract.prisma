// use prisma-next

enum RoleEnum {
  agent
  admin
  supervision
  personnel
}


enum StatutEnum {
  sur_site
  hors_site
}

enum TypeEntreeEnum {
  personnel
  visiteur
}

  model Utilisateur {
  id               Int         @id @default(autoincrement())
  nom              String?
  prenom           String?
  matricule        String?     @unique
  mot_de_passe     String?
  role             RoleEnum[]
  est_actif        Boolean?
  doit_changer_mdp Boolean     @default(true)
  session_id       String?

  
  personnel    Personnel?
  agent        Agent?
  audit_logs   AuditLog[]
}

model Personnel {
  id             Int          @id @default(autoincrement())
  id_utilisateur Int?         @unique
  utilisateur    Utilisateur? @relation(fields: [id_utilisateur], references: [id])
  id_fonction    Int?
  fonction       Fonction?    @relation(fields: [id_fonction], references: [id])
  vehicules      Vehicule[]
  mouvements     Mouvement[]  @relation("MouvementPersonnel")
  visites_recues Mouvement[] @relation("VisitePour")
  qr_code        String?
}

model Agent {
  id             Int          @id @default(autoincrement())
  id_utilisateur Int?         @unique
  utilisateur    Utilisateur? @relation(fields: [id_utilisateur], references: [id])
  id_parking     Int?
  parking        Parking?     @relation(fields: [id_parking], references: [id])
  mouvements     Mouvement[]
}

model Vehicule {
  id                        Int             @id @default(autoincrement())
  numero_plaque             String?         @unique
  marque                    String?
  couleur                   String?
  type                      TypeEntreeEnum?
  nom_proprietaire_externe  String?
  id_personnel              Int?
  personnel                 Personnel?      @relation(fields: [id_personnel], references: [id])
  mouvements                Mouvement[]
}

model Mouvement {
  id            Int         @id @default(autoincrement())
  id_vehicule   Int?
  vehicule      Vehicule?   @relation(fields: [id_vehicule], references: [id])
  heure_arrivee DateTime?
  heure_depart  DateTime?
  id_agent      Int?
  agent         Agent?      @relation(fields: [id_agent], references: [id])
  statut              StatutEnum?
  observation         String?
  type_entree         TypeEntreeEnum?
  id_personnel        Int?
  personnel           Personnel?      @relation("MouvementPersonnel", fields: [id_personnel], references: [id])
  id_personnel_visite Int?
  personnel_visite    Personnel?      @relation("VisitePour", fields: [id_personnel_visite], references: [id])
  id_place_parking    Int?
  place_parking       PlaceParking?   @relation(fields: [id_place_parking], references: [id])
  id_parking          Int?
  parking             Parking?        @relation(fields: [id_parking], references: [id])

  @@index([statut])
  @@index([heure_arrivee])
  @@index([heure_depart])
  @@index([heure_arrivee, heure_depart])
}

model Fonction {
  id             Int            @id @default(autoincrement())
  nom            String         @unique
  personnels     Personnel[]
  places_parking PlaceParking[]
}

model Parking {
  id                Int            @id @default(autoincrement())
  nom               String         @unique
  adresse           String?
  nombre_niveaux    Int?           @default(0)
  capacite_maximale Int?
  capacites_niveaux Json?
  places            PlaceParking[]
  agents            Agent[]
  mouvements        Mouvement[]
}

model PlaceParking {
  id             Int            @id @default(autoincrement())
  numero         String         @unique
  niveau         String
  id_parking     Int?
  parking        Parking?       @relation(fields: [id_parking], references: [id])
  id_fonction    Int?
  fonction       Fonction?      @relation(fields: [id_fonction], references: [id])
  est_visiteur   Boolean        @default(false)
  est_occupee    Boolean        @default(false)
  mouvements     Mouvement[]
}

model AuditLog {
  id             Int          @id @default(autoincrement())
  id_utilisateur Int?
  utilisateur    Utilisateur? @relation(fields: [id_utilisateur], references: [id])
  action         String?
  cible          String?
  details        String?
  date_action    DateTime?
}
