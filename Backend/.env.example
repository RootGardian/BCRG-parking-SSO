# ==============================================================================
# Configuration Environnement - Backend Parking BCRG (Production & Développement)
# ==============================================================================

# Environnement d'exécution ('production' ou 'development')
NODE_ENV=production

# Port d'écoute de l'API Node.js / Express
PORT=5002

# Origines autorisées pour les requêtes CORS (séparées par une virgule en production, ou '*' en dev)
# Exemple: https://parking.bcrg.gn,https://hub.bcrg.gn
CORS_ORIGIN=*

# Chaîne de connexion PostgreSQL (Prisma Next)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:bcrg_secure_password@localhost:5432/parking_bcrg_db?schema=public"

# Paramètres de base de données (si utilisation de Docker Compose)
DB_USER=postgres
DB_PASSWORD=bcrg_secure_password
DB_NAME=parking_bcrg_db
DB_PORT=5432

# ==============================================================================
# Sécurité & Authentification JWT Locale
# ==============================================================================
# Clé secrète robuste pour la signature des JWT internes (à générer aléatoirement en prod)
# Commande Linux/Mac pour générer: openssl rand -base64 32
JWT_SECRET="remplacez_par_une_cle_secrete_ultra_robuste_64_caracteres_min"

# Durée de validité des tokens JWT (ex: 8h, 24h, 7d)
JWT_EXPIRES_IN="24h"

# Poivre cryptographique additionnel pour le hachage des mots de passe avec bcrypt
PASSWORD_PEPPER="remplacez_par_un_poivre_cryptographique_unique"

# ==============================================================================
# Administrateur Système Initial
# ==============================================================================
ADMIN_NOM="Admin"
ADMIN_PRENOM="Principal"
ADMIN_MATRICULE="ADMIN-001"
ADMIN_PASSWORD="remplacez_par_un_mot_de_passe_admin_tres_complexe"
ADMIN_DOIT_CHANGER_MDP="true"

# ==============================================================================
# Fédération Single Sign-On (SSO) BCRG HUB
# ==============================================================================
# URL racine du backend BCRG HUB (utilisé pour les échanges SSO)
BCRG_HUB_URL="http://localhost:5001"

# Endpoint JWKS du BCRG HUB pour la vérification dynamique des clés publiques RSA/ECDSA
BCRG_HUB_JWKS_URL="http://localhost:5001/api/security/.well-known/jwks.json"

# Clé secrète partagée de secours (si signature symétrique HS256)
BCRG_HUB_JWT_SECRET="supersecret_sso_portal_key_2026"

# Chemin vers la clé publique PEM du BCRG HUB (si vérification asymétrique RS256)
BCRG_HUB_PUBLIC_KEY_PATH="./src/config/bcrg_hub_public.pem"
