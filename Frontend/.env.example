# ==============================================================================
# Configuration Environnement - Frontend Parking BCRG (Next.js 16)
# ==============================================================================

# Port d'écoute du serveur Next.js en production (défaut : 3002)
PORT=3002

# Environnement ('production' ou 'development')
NODE_ENV=production

# ------------------------------------------------------------------------------
# Connexion API Backend Parking
# ------------------------------------------------------------------------------
# URL publique de l'API Backend Parking (accessible depuis le navigateur de l'utilisateur final)
# Exemple en production: https://api-parking.bcrg.gn
# Exemple en local: http://localhost:5002
NEXT_PUBLIC_API_URL=https://api-parking.bcrg.gn

# URL interne serveur-à-serveur (utilisée par le serveur Next.js pour les routes SSR /sso)
# Si déployé sur le même réseau Docker : http://parking_bcrg_api:5002
# Si hébergé sur Vercel/serveur distant : identique à NEXT_PUBLIC_API_URL
INTERNAL_API_URL=https://api-parking.bcrg.gn

# ------------------------------------------------------------------------------
# Fédération SSO BCRG HUB
# ------------------------------------------------------------------------------
# URL publique de l'API BCRG HUB (pour l'initiation du flux SSO et validation des tokens)
# Exemple en production: https://api-hub.bcrg.gn
# Exemple en local: http://localhost:5001
NEXT_PUBLIC_BCRG_HUB_URL=https://api-hub.bcrg.gn

# URL de l'application Web BCRG HUB (utilisée pour rediriger l'utilisateur lors de la déconnexion)
# Exemple en production: https://hub.bcrg.gn
# Exemple en local: http://localhost:5173
NEXT_PUBLIC_BCRG_HUB_FRONTEND_URL=https://hub.bcrg.gn
