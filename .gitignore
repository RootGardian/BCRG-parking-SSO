# ==============================================================================
# Git Ignore - Monorepo Parking BCRG
# ==============================================================================

# Dépendances Node.js
node_modules/
*/node_modules/

# Builds et caches
.next/
*/.next/
dist/
*/dist/
build/
*/build/
*.tsbuildinfo
*/tsconfig.tsbuildinfo
next-env.d.ts
*/next-env.d.ts

# Variables d'environnement & Secrets (Garder uniquement les .example)
.env*
*/.env*
!*.example
!*/.env.example
!*/.env.docker.example
*.pem
*/src/config/*.pem

# Téléversements et fichiers temporaires
uploads/*
!uploads/.gitkeep
Backend/uploads/*
!Backend/uploads/.gitkeep
scratch/
*/scratch/

# Sauvegardes locales de dépôts
*.git_standalone*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Fichiers OS & IDE
.DS_Store
Thumbs.db
.agents/
.claude/
.cursor/
.devin/
.idea/
.vscode/

# PWA service worker générés
Frontend/public/sw.js*
Frontend/public/workbox-*.js*
Frontend/public/swe-worker-*.js*
