# ===================================================================
#  Configuration Environnement Docker — Parking BCRG (Full Stack)
# ===================================================================

# Ports d'écoute des services
FRONTEND_PORT=3002
BACKEND_PORT=5002

# Base de Données PostgreSQL
POSTGRES_DB=parking_bcrg_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bcrg_secure_password
POSTGRES_PORT=5432

# URLs de communication
NEXT_PUBLIC_API_URL=http://localhost:5002
INTERNAL_API_URL=http://backend:5002
NEXT_PUBLIC_BCRG_HUB_URL=http://localhost:5001
NEXT_PUBLIC_BCRG_HUB_FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=*

# Sécurité & JWT Backend
JWT_SECRET=bcrg_parking_secret_key_jwt_2026_super_secure
JWT_EXPIRES_IN=24h
PASSWORD_PEPPER=bcrg_parking_pepper_2026
ADMIN_PASSWORD=votre_mot_de_passe_admin_tres_complexe
